{
  "$schema": "https://opencode.ai/config.json",
  // Point "package" at this repo after `npm run build`, or publish and use the npm name.
  "plugins": [
    {
      "package": "opencode-token-quota",
      "options": {
        "limit": 15000000,
        "windowHours": 4,
        "locale": "ru"
      }
    }
  ]
}
